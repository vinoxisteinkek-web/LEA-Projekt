  lineBeforeRefuel: Fill up first, then come pay.
  greeting: Evening. Pump one?
  payTopic:
    question: Yes, pump one. Here you go.
    answer:
    - That's forty. ...Thanks.
  topics:
  - question: Quiet night, huh?
