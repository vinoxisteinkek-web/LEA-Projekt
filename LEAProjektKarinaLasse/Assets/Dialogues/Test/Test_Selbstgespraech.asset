    seconds: 1.5
    pauseAfterAudio: 0.4
    nextNodeId: 
    eventName: 
    choices: []
  - id: 
    speakerData: {fileID: 11400000, guid: de67a5e4365b0444fa2df1a16478976e, type: 2}
    speaker: 
    text: Mit dem Tank komme ich nicht weit. Ich halte doch an.
