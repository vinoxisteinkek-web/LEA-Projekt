  - id: 
    speakerData: {fileID: 11400000, guid: de67a5e4365b0444fa2df1a16478976e, type: 2}
    speaker: 
    text: "Hier drau\xDFen ist echt niemand unterwegs."
    voiceClip: {fileID: 0}
    voiceVolume: 1
    delayBefore: 0
    advance: 0
    seconds: 3
    pauseAfterAudio: 0.4
    nextNodeId: 
    eventName: 
