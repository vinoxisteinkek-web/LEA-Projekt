  - id: frage
    speakerData: {fileID: 11400000, guid: de67a5e4365b0444fa2df1a16478976e, type: 2}
    speaker: 
    text: Soll ich wirklich da anhalten?
    voiceClip: {fileID: 0}
    voiceVolume: 1
    delayBefore: 0
    advance: 0
    seconds: 3
    pauseAfterAudio: 0.4
    nextNodeId: 
    eventName: 
    choices:
    - text: Ja, ich brauche Benzin.
      nextNodeId: ja
      eventName: test_ja
    - text: Nein... lieber weiterfahren.
      nextNodeId: nein
      eventName: test_nein
  - id: ja
    speakerData: {fileID: 11400000, guid: de67a5e4365b0444fa2df1a16478976e, type: 2}
    speaker: 
    text: Okay. Kurz tanken und dann nichts wie weg.
    voiceClip: {fileID: 0}
    voiceVolume: 1
    delayBefore: 0
    advance: 0
    seconds: 3
    pauseAfterAudio: 0.4
    nextNodeId: END
    eventName: 
